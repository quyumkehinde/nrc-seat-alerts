# Supabase -> Project Settings -> API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Secret key, NOT publishable. Server-side only.
# Older projects can still use their legacy service_role key here.
SUPABASE_SECRET_KEY=sb_secret_...

# Resend. Installing Resend from the Vercel Marketplace injects this for you.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="NRC Seat Alerts <alerts@yourdomain.com>"   # must be a verified domain

# Your deployed URL, used to build confirm/unsubscribe links.
SITE_URL=https://your-app.vercel.app

# Shared secret between this app and the Cloudflare trigger Worker.
# Generate with: openssl rand -base64 32
# Set the SAME value here (Vercel env vars) and in the Worker:
#   cd trigger && npx wrangler secret put CRON_SECRET
# Required in production -- /api/cron/poll refuses to run without it.
CRON_SECRET=
